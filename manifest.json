{
  "manifest_version": 3,
  "name": "Dev Helper",
  "version": "1.2.0",
  "description": "Набор небольших помощников для повседневной работы разработчика",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Dev Helper — настройки",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-mr": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Скопировать название и ссылку текущего MR"
    }
  }
}
